// ==========================================================================
// FICHIER UNIQUE des regles Firestore du projet restaurantpos-7a4f0d11.
//
// Il sert le SITE (poksol.com) ET l'APPLICATION Poket Restaurants (caisse) :
// Firestore n'a qu'un jeu de regles actif, chaque deploiement remplace le
// precedent. Ne JAMAIS deployer d'autres regles Firestore vers ce projet ;
// les deux projets pointent vers ce fichier (voir firebase/README.md).
//
// Trois sortes de regles, reperables par leur etiquette :
//   [COMMUN] regles partagees par le site et l'application (roles, equipe,
//            invitations, clients, reservations, reglages, catalogue) ;
//   [APPLI]  regles propres a l'application de caisse (commandes, appareils,
//            licences, impressions, synchronisation, mise a jour) ;
//   [SITE]   regles propres au site (pages publiques, contact, menu QR).
//
// Un seul calcul de role pour tous : isRestaurantMember / isAdmin /
// isManagerOrAdmin. « owner » = admin ; le createur du restaurant est admin.
// Tout ce qui n'est pas liste ici est refuse. Ajouter une regle = la placer
// dans la bonne section ; tests/rules verifie l'emplacement de chaque bloc.
// ==========================================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================================
    // [COMMUN] Fonctions partagees (roles, equipe, invitations, clients)
    // ==========================================================================

    function signedIn() {
      return request.auth != null;
    }

    function isOwnUserDoc(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function modernStaffDoc(restaurantId) {
      return get(/databases/$(database)/documents/restaurants/$(restaurantId)/staff/$(request.auth.uid));
    }

    function legacyStaffDoc(restaurantId) {
      return get(/databases/$(database)/documents/restaurants/$(restaurantId)/staff_users/$(request.auth.uid));
    }

    function hasModernStaff(restaurantId) {
      return exists(/databases/$(database)/documents/restaurants/$(restaurantId)/staff/$(request.auth.uid));
    }

    function hasLegacyStaff(restaurantId) {
      return exists(/databases/$(database)/documents/restaurants/$(restaurantId)/staff_users/$(request.auth.uid));
    }

    function storedRoleForRestaurant(restaurantId) {
      return hasModernStaff(restaurantId)
        ? modernStaffDoc(restaurantId).data.role
        : (hasLegacyStaff(restaurantId)
            ? legacyStaffDoc(restaurantId).data.role
            : '');
    }

    function roleForRestaurant(restaurantId) {
      return storedRoleForRestaurant(restaurantId) == 'owner'
        ? 'admin'
        : storedRoleForRestaurant(restaurantId);
    }

    function restaurantPath(restaurantId) {
      return /databases/$(database)/documents/restaurants/$(restaurantId);
    }

    // Le createur du restaurant (createdBy cote application, ownerUid cote site)
    // est administrateur meme sans fiche staff : c'est le cas des restaurants
    // crees depuis le site avant l'unification des roles.
    function isRestaurantCreator(restaurantId) {
      return signedIn()
        && exists(restaurantPath(restaurantId))
        && (
          get(restaurantPath(restaurantId)).data.get('createdBy', '') == request.auth.uid
          || get(restaurantPath(restaurantId)).data.get('ownerUid', '') == request.auth.uid
        );
    }

    function hasActiveStaffRecord(restaurantId) {
      return signedIn()
        && (
          (hasModernStaff(restaurantId) && modernStaffDoc(restaurantId).data.active != false)
          || (hasLegacyStaff(restaurantId) && legacyStaffDoc(restaurantId).data.active != false)
        );
    }

    // UNE SEULE definition des roles pour le site et pour l'application :
    // tout chemin ci-dessous passe par ces trois fonctions.
    function isRestaurantMember(restaurantId) {
      return hasActiveStaffRecord(restaurantId) || isRestaurantCreator(restaurantId);
    }

    function isAdmin(restaurantId) {
      return (
          hasActiveStaffRecord(restaurantId)
          && roleForRestaurant(restaurantId) == 'admin'
        )
        || isRestaurantCreator(restaurantId);
    }

    function isManagerOrAdmin(restaurantId) {
      return (
          hasActiveStaffRecord(restaurantId)
          && roleForRestaurant(restaurantId) in ['admin', 'manager']
        )
        || isRestaurantCreator(restaurantId);
    }

    function hasValidInviteForJoin(restaurantId) {
      return request.resource.data.inviteCode is string
        && exists(/databases/$(database)/documents/restaurant_invites/$(request.resource.data.inviteCode))
        && get(/databases/$(database)/documents/restaurant_invites/$(request.resource.data.inviteCode)).data.restaurantId == restaurantId
        && get(/databases/$(database)/documents/restaurant_invites/$(request.resource.data.inviteCode)).data.status in ['active', 'pending']
        && get(/databases/$(database)/documents/restaurant_invites/$(request.resource.data.inviteCode)).data.active != false
        && (
          !(get(/databases/$(database)/documents/restaurant_invites/$(request.resource.data.inviteCode)).data.get('expiresAt', null) is timestamp)
          || get(/databases/$(database)/documents/restaurant_invites/$(request.resource.data.inviteCode)).data.get('expiresAt', null) > request.time
        );
    }

    function isSelfStaffCreateWithValidInvite(restaurantId, userId) {
      return isOwnUserDoc(userId)
        && request.resource.data.restaurantId == restaurantId
        && request.resource.data.active == true
        && request.resource.data.role in ['admin', 'manager', 'staff']
        && hasValidInviteForJoin(restaurantId)
        // Le role pris a l'inscription doit etre celui de l'invitation : sans ce
        // controle, une invitation « staff » permettait de se declarer admin.
        && get(/databases/$(database)/documents/restaurant_invites/$(request.resource.data.inviteCode)).data.role == request.resource.data.role;
    }

    function isSelfAccessRequestWithValidInvite(restaurantId, userId) {
      return isOwnUserDoc(userId)
        && request.resource.data.userId == userId
        && request.resource.data.restaurantId == restaurantId
        && request.resource.data.status == 'pending'
        && hasValidInviteForJoin(restaurantId);
    }

    function isSafeSelfAccessRequestUpdate(restaurantId, userId) {
      return isSelfAccessRequestWithValidInvite(restaurantId, userId)
        && resource.data.userId == userId
        && resource.data.restaurantId == restaurantId
        && resource.data.status in ['pending', 'rejected'];
    }

    function isSelfInitialAdminCreate(restaurantId, userId) {
      return isOwnUserDoc(userId)
        && request.resource.data.restaurantId == restaurantId
        && request.resource.data.active == true
        && request.resource.data.role == 'admin'
        && existsAfter(/databases/$(database)/documents/restaurants/$(restaurantId))
        && (
          getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)).data.get('createdBy', '') == request.auth.uid
          || getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)).data.get('ownerUid', '') == request.auth.uid
        );
    }

    function isAdminUserRestaurantAttachUpdate() {
      return signedIn()
        && request.resource.data.activeRestaurantId is string
        && isAdmin(request.resource.data.activeRestaurantId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'activeRestaurantId',
          'restaurantIds',
          'updatedAt'
        ]);
    }

    function validInviteRole() {
      return request.resource.data.role in ['admin', 'manager', 'staff'];
    }

    function validInviteWrite(inviteCode) {
      return request.resource.data.restaurantId is string
        && request.resource.data.inviteCode == inviteCode
        && request.resource.data.email is string
        && request.resource.data.status in ['active', 'cancelled', 'used']
        && validInviteRole();
    }

    function keepsSameRole() {
      return request.resource.data.role == resource.data.role;
    }

    function keepsSameRestaurant(restaurantId) {
      return request.resource.data.restaurantId == restaurantId
        && request.resource.data.restaurantId == resource.data.restaurantId;
    }

    function keepsSameActive() {
      return request.resource.data.active == resource.data.active;
    }

    function isSafeSelfStaffUpdate(restaurantId) {
      return request.resource.data.restaurantId == restaurantId
        && request.resource.data.restaurantId == resource.data.restaurantId
        && request.resource.data.role == resource.data.role
        && request.resource.data.active == resource.data.active
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'restaurantId',
          'role',
          'active',
          'permissions',
          'uid'
        ]);
    }

    function isActiveCustomerAccount(restaurantId, customerId) {
      return exists(/databases/$(database)/documents/restaurants/$(restaurantId)/customers/$(customerId))
        && get(/databases/$(database)/documents/restaurants/$(restaurantId)/customers/$(customerId)).data.active != false;
    }

    function isValidCustomerCreditCorrection(restaurantId, customerId) {
      return isRestaurantMember(restaurantId)
        && isActiveCustomerAccount(restaurantId, customerId)
        && resource.data.customerId == customerId
        && request.resource.data.customerId == resource.data.customerId
        && resource.data.type == 'credit'
        && request.resource.data.type == resource.data.type
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && request.resource.data.correctionReason is string
        && request.resource.data.correctionReason.size() > 0
        && request.resource.data.correctedAt is string
        && request.resource.data.correctionCount is int
        && request.resource.data.correctionCount == resource.data.get('correctionCount', 0) + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'amount',
          'note',
          'correctedAt',
          'correctionReason',
          'correctionCount',
          'correctionHistory'
        ]);
    }

    // ==========================================================================
    // [APPLI] Fonctions de la caisse (commandes, appareils, licences, impressions)
    // ==========================================================================

    function isValidStaffDeviceWrite(restaurantId, deviceId) {
      return request.resource.data.restaurantId == restaurantId
        && request.resource.data.token == deviceId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.enabled is bool
        && request.resource.data.platform is string
        && request.resource.data.updatedAt is timestamp;
    }

    function isOwnStaffDevice() {
      return signedIn()
        && resource.data.userId == request.auth.uid;
    }

    function isValidRoomOrderOpWrite(restaurantId, opId) {
      return request.resource.data.restaurantId == restaurantId
        && request.resource.data.opId == opId
        && request.resource.data.aggregateType is string
        && request.resource.data.aggregateId is string
        && request.resource.data.opType is string
        && request.resource.data.actorDeviceId is string
        && request.resource.data.lamport is int
        && request.resource.data.vectorClock is map
        && request.resource.data.payload is map
        && request.resource.data.payloadHash is string
        && request.resource.data.idempotencyKey is string
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string;
    }

    function isValidCanonicalRoomOrderWrite(restaurantId, tableId) {
      return request.resource.data.restaurantId == restaurantId
        && request.resource.data.tableId == tableId
        && (
          !('createdAt' in request.resource.data)
          || request.resource.data.createdAt is string
        )
        && request.resource.data.label is string
        && request.resource.data.displayNumber is int
        && request.resource.data.continuousNumber is int
        && request.resource.data.dailyNumber is int
        && request.resource.data.lines is list
        && request.resource.data.isOpen is bool
        && request.resource.data.isClosed is bool
        && request.resource.data.revision is int
        && request.resource.data.lastAction is string
        && request.resource.data.lastWriterDeviceSessionId is string;
    }

    function keepsSameRoomOrderStableIdentity(tableId) {
      return request.resource.data.restaurantId == resource.data.restaurantId
        && request.resource.data.tableId == resource.data.tableId
        && request.resource.data.tableId == tableId
        && (
          !('createdAt' in resource.data)
          || request.resource.data.createdAt == resource.data.createdAt
        );
    }

    function keepsSameRoomOrderOpIdentity(opId) {
      return request.resource.data.opId == resource.data.opId
        && request.resource.data.opId == opId
        && request.resource.data.aggregateType == resource.data.aggregateType
        && request.resource.data.aggregateId == resource.data.aggregateId
        && request.resource.data.actorDeviceId == resource.data.actorDeviceId
        && request.resource.data.lamport == resource.data.lamport;
    }

    function isValidDistributedOperationWrite(restaurantId, operationId) {
      return request.resource.data.restaurantId == restaurantId
        && request.resource.data.operationId == operationId
        && request.resource.data.deviceId is string
        && request.resource.data.sessionId is string
        && request.resource.data.localSequence is int
        && request.resource.data.createdAtLocal is string
        && request.resource.data.actionType is string
        && request.resource.data.entityType is string
        && request.resource.data.entityId is string
        && request.resource.data.payload is map
        && request.resource.data.payloadHash is string
        && request.resource.data.idempotencyKey is string
        && request.resource.data.status is string
        && request.resource.data.sourceChannel is string
        && request.resource.data.retryCount is int;
    }

    function keepsSameDistributedOperationIdentity(operationId) {
      return request.resource.data.operationId == resource.data.operationId
        && request.resource.data.operationId == operationId
        && request.resource.data.restaurantId == resource.data.restaurantId
        && request.resource.data.deviceId == resource.data.deviceId
        && request.resource.data.sessionId == resource.data.sessionId
        && request.resource.data.localSequence == resource.data.localSequence
        && request.resource.data.actionType == resource.data.actionType
        && request.resource.data.entityType == resource.data.entityType
        && request.resource.data.entityId == resource.data.entityId;
    }

    function isValidDeviceSyncStateWrite(deviceId) {
      return request.resource.data.deviceId == deviceId
        && request.resource.data.pendingCloudOperations is int
        && request.resource.data.pendingLanOperations is int
        && request.resource.data.missingOperations is int
        && request.resource.data.needsSync is bool;
    }

    function isValidUserDeviceSessionWrite(restaurantId, userId) {
      return request.resource.data.restaurantId == restaurantId
        && request.resource.data.userId == userId
        && request.resource.data.deviceId is string
        && request.resource.data.deviceId.size() > 0
        && request.resource.data.sessionId is string
        && request.resource.data.sessionId.size() > 0
        && request.resource.data.deviceLabel is string
        && request.resource.data.userName is string
        && request.resource.data.userEmail is string
        && request.resource.data.role is string
        && request.resource.data.status in ['active', 'released']
        && request.resource.data.claimedAt is timestamp
        && request.resource.data.lastSeenAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && (
          request.resource.data.status == 'released'
          || request.resource.data.expiresAt <= request.time + duration.value(5, 'm')
        );
    }

    function licensePath(restaurantId) {
      return /databases/$(database)/documents/restaurants/$(restaurantId)/license/current;
    }

    function isValidRestaurantLicenseWrite(restaurantId) {
      return request.resource.data.restaurantId == restaurantId
        && request.resource.data.plan is string
        && request.resource.data.status in ['active', 'trial', 'expired', 'blocked']
        && request.resource.data.maxDevices is int
        && request.resource.data.maxDevices >= 0
        && request.resource.data.maxUsers is int
        && request.resource.data.maxUsers >= 0
        && request.resource.data.deviceSlotsUsed is int
        && request.resource.data.deviceSlotsUsed >= 0
        && request.resource.data.deviceSlotsUsed <= request.resource.data.maxDevices
        && request.resource.data.updatedAt is timestamp;
    }

    function isDefaultFreeLicenseCreate(restaurantId) {
      return isValidRestaurantLicenseWrite(restaurantId)
        && request.resource.data.plan == 'free'
        && request.resource.data.status == 'active'
        && request.resource.data.maxDevices == 1
        && request.resource.data.maxUsers == 1
        && request.resource.data.deviceSlotsUsed == 1
        && request.resource.data.billingManagedBy == 'manual'
        && request.resource.data.schemaVersion == 1
        && request.resource.data.createdAt is timestamp;
    }

    function keepsSameCommercialLicenseTerms() {
      return request.resource.data.restaurantId == resource.data.restaurantId
        && request.resource.data.plan == resource.data.plan
        && request.resource.data.status == resource.data.status
        && request.resource.data.maxDevices == resource.data.maxDevices
        && request.resource.data.maxUsers == resource.data.maxUsers;
    }

    function licenseDeviceSlotsIncremented() {
      return request.resource.data.deviceSlotsUsed == resource.data.deviceSlotsUsed + 1
        && request.resource.data.deviceSlotsUsed <= resource.data.maxDevices;
    }

    function licenseDeviceSlotsDecremented() {
      return request.resource.data.deviceSlotsUsed == resource.data.deviceSlotsUsed - 1
        && request.resource.data.deviceSlotsUsed >= 0;
    }

    function isValidLicensedDeviceWrite(deviceId) {
      return request.resource.data.deviceId == deviceId
        && request.resource.data.label is string
        && request.resource.data.platform is string
        && request.resource.data.active is bool
        && request.resource.data.claimedByUserId is string
        && request.resource.data.claimedByUserName is string
        && request.resource.data.claimedByUserEmail is string
        && request.resource.data.lastSeenAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isOwnLicensedDeviceClaim() {
      return request.resource.data.claimedByUserId == request.auth.uid;
    }

    function keepsSameLicensedDeviceOwner() {
      return request.resource.data.claimedByUserId == resource.data.claimedByUserId;
    }

    function licenseAllowsNewDeviceClaim(restaurantId) {
      return getAfter(licensePath(restaurantId)).data.status in ['active', 'trial']
        && getAfter(licensePath(restaurantId)).data.deviceSlotsUsed
          <= getAfter(licensePath(restaurantId)).data.maxDevices
        && (
          (
            exists(licensePath(restaurantId))
            && getAfter(licensePath(restaurantId)).data.deviceSlotsUsed
              == get(licensePath(restaurantId)).data.deviceSlotsUsed + 1
          )
          || (
            !exists(licensePath(restaurantId))
            && getAfter(licensePath(restaurantId)).data.plan == 'free'
            && getAfter(licensePath(restaurantId)).data.maxDevices == 1
            && getAfter(licensePath(restaurantId)).data.maxUsers == 1
            && getAfter(licensePath(restaurantId)).data.deviceSlotsUsed == 1
          )
        );
    }

    function licenseAllowsDeviceRemoval(restaurantId) {
      return exists(licensePath(restaurantId))
        && getAfter(licensePath(restaurantId)).data.deviceSlotsUsed
          == get(licensePath(restaurantId)).data.deviceSlotsUsed - 1
        && getAfter(licensePath(restaurantId)).data.deviceSlotsUsed >= 0;
    }

    function isValidOperationAckWrite() {
      return request.resource.data.operationId is string
        && request.resource.data.receivedByDeviceId is string
        && request.resource.data.channel is string
        && request.resource.data.applied is bool;
    }

    function isValidSyncCounterCreate(counterId) {
      return request.resource.data.namespace is string
        && request.resource.data.namespace == counterId
        && request.resource.data.nextValue is int
        && request.resource.data.nextValue >= 1;
    }

    function isValidSyncCounterUpdate(counterId) {
      return isValidSyncCounterCreate(counterId)
        && resource.data.namespace == counterId
        && (
          !('nextValue' in resource.data)
          || !(resource.data.nextValue is int)
          || request.resource.data.nextValue >= resource.data.nextValue
        );
    }

    function isValidCanonicalPrintJobWrite(restaurantId, printJobId) {
      return request.resource.data.restaurantId == restaurantId
        && request.resource.data.printJobId == printJobId
        && request.resource.data.orderId is string
        && request.resource.data.targetPrinterId is string
        && request.resource.data.type is string
        && request.resource.data.payloadHash is string
        && request.resource.data.idempotencyKey is string
        && request.resource.data.status in [
          'pending',
          'claimed',
          'printed',
          'failed',
          'cancelled'
        ]
        && request.resource.data.retryCount is int
        && request.resource.data.retryCount >= 0
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && (
          !('scheduledAt' in request.resource.data)
          || request.resource.data.scheduledAt == null
          || request.resource.data.scheduledAt is string
        )
        && request.resource.data.payload is map;
    }

    function keepsSamePrintJobBusinessIdentity() {
      return request.resource.data.restaurantId == resource.data.restaurantId
        && request.resource.data.printJobId == resource.data.printJobId
        && request.resource.data.orderId == resource.data.orderId
        && request.resource.data.targetPrinterId == resource.data.targetPrinterId
        && request.resource.data.type == resource.data.type
        && request.resource.data.payloadHash == resource.data.payloadHash
        && request.resource.data.idempotencyKey == resource.data.idempotencyKey
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          (!('scheduledAt' in request.resource.data)
            && !('scheduledAt' in resource.data))
          || request.resource.data.scheduledAt == resource.data.scheduledAt
          || (
            request.resource.data.scheduledAt == null
            && !('scheduledAt' in resource.data)
          )
        )
        && request.resource.data.payload == resource.data.payload;
    }

    function keepsSamePrintJobBusinessIdentityExceptSchedule() {
      return request.resource.data.restaurantId == resource.data.restaurantId
        && request.resource.data.printJobId == resource.data.printJobId
        && request.resource.data.orderId == resource.data.orderId
        && request.resource.data.targetPrinterId == resource.data.targetPrinterId
        && request.resource.data.type == resource.data.type
        && request.resource.data.payloadHash == resource.data.payloadHash
        && request.resource.data.idempotencyKey == resource.data.idempotencyKey
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function payloadOnlyClearsScheduledAt() {
      return request.resource.data.payload.diff(resource.data.payload)
          .affectedKeys()
          .hasOnly(['scheduledAt'])
        && ('scheduledAt' in resource.data.payload)
        && !('scheduledAt' in request.resource.data.payload);
    }

    function isPrintJobMakeDueNowTransition() {
      return resource.data.status == 'pending'
        && request.resource.data.status == 'pending'
        && ('scheduledAt' in resource.data)
        && (
          !('scheduledAt' in request.resource.data)
          || request.resource.data.scheduledAt == null
        )
        && request.resource.data.retryCount == 0
        && keepsSamePrintJobBusinessIdentityExceptSchedule()
        && (
          request.resource.data.payload == resource.data.payload
          || payloadOnlyClearsScheduledAt()
        );
    }

    function isPrintJobCancelTransition() {
      return resource.data.status in ['pending', 'failed', 'claimed']
        && request.resource.data.status == 'cancelled'
        && keepsSamePrintJobBusinessIdentity();
    }

    function isValidPrintJobCreate(restaurantId, printJobId) {
      return isValidCanonicalPrintJobWrite(restaurantId, printJobId)
        && request.resource.data.status == 'pending'
        && request.resource.data.retryCount == 0;
    }

    function isPrintJobClaimTransition() {
      return resource.data.status in ['pending', 'failed']
        && request.resource.data.status == 'claimed'
        && request.resource.data.claimedBy is string
        && request.resource.data.claimedBy.size() > 0
        && request.resource.data.claimedAt is string;
    }

    function isPrintJobClaimedResultTransition() {
      return resource.data.status == 'claimed'
        && request.resource.data.status in ['printed', 'failed']
        && request.resource.data.claimedBy == resource.data.claimedBy
        && request.resource.data.claimedAt == resource.data.claimedAt;
    }

    function isPrintJobPendingFailureTransition() {
      return resource.data.status == 'pending'
        && request.resource.data.status == 'failed';
    }

    function isPrintJobRetryResetTransition() {
      return resource.data.status == 'failed'
        && request.resource.data.status == 'pending'
        && request.resource.data.retryCount == resource.data.retryCount;
    }

    function isValidPrintJobUpdate(restaurantId, printJobId) {
      return isValidCanonicalPrintJobWrite(restaurantId, printJobId)
        && resource.data.status != 'printed'
        && (
          (
            keepsSamePrintJobBusinessIdentity()
            && (
              isPrintJobClaimTransition()
              || isPrintJobClaimedResultTransition()
              || isPrintJobPendingFailureTransition()
              || isPrintJobRetryResetTransition()
              || isPrintJobCancelTransition()
              || (
                resource.data.status == request.resource.data.status
                && request.resource.data.claimedBy == resource.data.claimedBy
              )
            )
          )
          || isPrintJobMakeDueNowTransition()
        );
    }

    // ==========================================================================
    // [SITE] Fonctions du site (reservations depuis une page publique)
    // ==========================================================================

    // Reservation creee depuis une page publique (visiteur anonyme ou connecte).
    function publicReservationsOpen(restaurantId) {
      return (
          exists(restaurantPath(restaurantId))
          && get(restaurantPath(restaurantId)).data.get('publicPageEnabled', false) == true
          && get(restaurantPath(restaurantId)).data.get('reservationEnabled', false) == true
        )
        || (
          exists(/databases/$(database)/documents/publicRestaurants/$(restaurantId))
          && get(/databases/$(database)/documents/publicRestaurants/$(restaurantId)).data.get('publicPageEnabled', false) == true
          && get(/databases/$(database)/documents/publicRestaurants/$(restaurantId)).data.get('reservationEnabled', false) == true
        );
    }

    function validPublicReservation(restaurantId) {
      let d = request.resource.data;
      return d.keys().hasAll(['customerName', 'customerPhone', 'date', 'time', 'status'])
        && d.size() <= 30
        && d.status == 'planned'
        && d.get('restaurantId', restaurantId) == restaurantId
        && d.customerName is string && d.customerName.size() > 0 && d.customerName.size() <= 120
        && d.customerPhone is string && d.customerPhone.size() >= 3 && d.customerPhone.size() <= 40
        && d.date is string && d.date.size() <= 10
        && d.time is string && d.time.size() <= 8
        && d.get('customerEmail', '') is string && d.get('customerEmail', '').size() <= 254
        && d.get('notes', '') is string && d.get('notes', '').size() <= 1000
        && (!('guests' in d) || (d.guests is number && d.guests >= 1 && d.guests <= 50));
    }

    // ==========================================================================
    // [COMMUN] Collections partagees : utilisateurs et invitations
    // ==========================================================================

    match /users/{userId} {
      allow read, create: if isOwnUserDoc(userId);
      allow update: if isOwnUserDoc(userId)
        || isAdminUserRestaurantAttachUpdate();
      allow delete: if false;
    }

    match /restaurant_invites/{inviteCode} {
      // Lecture par code : admin du restaurant ou invitation encore utilisable.
      // Le listing est reserve aux admins (sinon tout compte pouvait enumerer les codes).
      allow get: if signedIn()
        && (
          (
            resource.data.restaurantId is string
            && isAdmin(resource.data.restaurantId)
          )
          || (
            resource.data.status in ['active', 'pending']
            && resource.data.active != false
          )
        );
      allow list: if signedIn()
        && resource.data.restaurantId is string
        && isAdmin(resource.data.restaurantId);

      allow create: if signedIn()
        && validInviteWrite(inviteCode)
        && request.resource.data.status == 'active'
        && request.resource.data.createdBy == request.auth.uid
        && isAdmin(request.resource.data.restaurantId);

      allow update: if signedIn()
        && resource.data.restaurantId is string
        && isAdmin(resource.data.restaurantId)
        && validInviteWrite(inviteCode)
        && request.resource.data.restaurantId == resource.data.restaurantId
        && request.resource.data.inviteCode == resource.data.inviteCode;

      allow delete: if false;
    }

    // ==========================================================================
    // [COMMUN] Restaurants : document, equipe, clients, reservations, reglages, catalogue
    // ==========================================================================

    match /restaurants/{restaurantId} {
      allow create: if signedIn()
        && (
          request.resource.data.get('createdBy', '') == request.auth.uid
          || request.resource.data.get('ownerUid', '') == request.auth.uid
        );
      // Les pages publiques lisent publicRestaurants, jamais ce document.
      allow get: if isRestaurantMember(restaurantId);
      allow list: if signedIn()
        && (
          resource.data.get('createdBy', '') == request.auth.uid
          || resource.data.get('ownerUid', '') == request.auth.uid
        );
      allow update, delete: if isAdmin(restaurantId);

      // ==========================================================================
      // [COMMUN] Sous-collections d'un restaurant partagees par le site et l'application
      // ==========================================================================

      match /access_requests/{userId} {
        allow read: if isOwnUserDoc(userId) || isAdmin(restaurantId);
        allow create: if isSelfAccessRequestWithValidInvite(
          restaurantId,
          userId
        );
        allow update: if isAdmin(restaurantId)
          || isSafeSelfAccessRequestUpdate(restaurantId, userId);
        allow delete: if isAdmin(restaurantId);
      }

      match /reservations/{reservationId} {
        allow read: if isRestaurantMember(restaurantId);
        // Membres (site et application), ou [SITE] visiteur d'une page publique.
        allow create: if (
            isRestaurantMember(restaurantId)
            && request.resource.data.restaurantId == restaurantId
          )
          || (
            publicReservationsOpen(restaurantId)
            && validPublicReservation(restaurantId)
          );
        allow update: if isRestaurantMember(restaurantId)
          && request.resource.data.restaurantId == restaurantId;
        allow delete: if isAdmin(restaurantId);
      }

      match /settings/{settingId} {
        allow read: if isRestaurantMember(restaurantId);
        allow write: if isManagerOrAdmin(restaurantId);
      }

      match /customers/{customerId} {
        allow read: if isRestaurantMember(restaurantId);
        allow create, update: if isRestaurantMember(restaurantId);
        allow delete: if isManagerOrAdmin(restaurantId);

        match /movements/{movementId} {
          allow read: if isRestaurantMember(restaurantId);
          allow create: if isRestaurantMember(restaurantId)
            && isActiveCustomerAccount(restaurantId, customerId)
            && request.resource.data.customerId == customerId
            && request.resource.data.type in ['debit', 'credit']
            && request.resource.data.amount is number
            && request.resource.data.amount > 0;
          allow update: if isValidCustomerCreditCorrection(restaurantId, customerId);
          allow delete: if false;
        }
      }

      match /catalog_categories/{categoryId} {
        allow read: if isRestaurantMember(restaurantId);
        allow write: if isManagerOrAdmin(restaurantId);

        match /items/{itemId} {
          allow read: if isRestaurantMember(restaurantId);
          allow write: if isManagerOrAdmin(restaurantId);
        }
      }

      match /staff/{userId} {
        allow read: if isOwnUserDoc(userId) || isRestaurantMember(restaurantId);
        allow create: if isSelfInitialAdminCreate(restaurantId, userId)
          || isSelfStaffCreateWithValidInvite(restaurantId, userId)
          || isAdmin(restaurantId);
        allow update: if isAdmin(restaurantId)
          || (
            isOwnUserDoc(userId)
            && isSafeSelfStaffUpdate(restaurantId)
          );
        allow delete: if isAdmin(restaurantId);
      }

      match /staff_users/{userId} {
        allow read: if isOwnUserDoc(userId) || isRestaurantMember(restaurantId);

        allow create: if isSelfInitialAdminCreate(restaurantId, userId)
          || (
            isSelfStaffCreateWithValidInvite(restaurantId, userId)
            && request.resource.data.role == 'staff'
          )
          || isAdmin(restaurantId);

        allow update: if isAdmin(restaurantId)
          || (
            isOwnUserDoc(userId)
            && keepsSameRole()
            && keepsSameRestaurant(restaurantId)
            && keepsSameActive()
          );

        allow delete: if isAdmin(restaurantId);
      }

      // ==========================================================================
      // [APPLI] Sous-collections propres a la caisse
      // ==========================================================================

      match /staff_devices/{deviceId} {
        allow read: if isAdmin(restaurantId);
        allow create, update: if isRestaurantMember(restaurantId)
          && isValidStaffDeviceWrite(restaurantId, deviceId);
        allow delete: if isAdmin(restaurantId) || isOwnStaffDevice();
      }

      match /quotes/{quoteId} {
        allow read: if isRestaurantMember(restaurantId);
        allow create: if isRestaurantMember(restaurantId)
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.quoteId == quoteId
          && request.resource.data.quoteNumber is string
          && request.resource.data.status in ['issued', 'cancelled', 'accepted', 'refused', 'expired', 'transformed_to_order']
          && request.resource.data.sourceTableId is string
          && request.resource.data.sourceTable is map
          && request.resource.data.customer is map
          && request.resource.data.issuedAt is string
          && request.resource.data.validUntil is string
          && request.resource.data.totalTtc is number;
        allow update: if isRestaurantMember(restaurantId)
          && request.resource.data.restaurantId == resource.data.restaurantId
          && request.resource.data.quoteId == resource.data.quoteId
          && request.resource.data.quoteNumber == resource.data.quoteNumber
          && request.resource.data.sourceTableId == resource.data.sourceTableId
          && request.resource.data.status in ['issued', 'cancelled', 'accepted', 'refused', 'expired', 'transformed_to_order'];
        allow delete: if isManagerOrAdmin(restaurantId);
      }

      match /counters/{counterId} {
        allow read: if isRestaurantMember(restaurantId);
        allow create, update: if isRestaurantMember(restaurantId)
          && counterId in ['quotes']
          && request.resource.data.next is int;
        allow delete: if isManagerOrAdmin(restaurantId);
      }

      match /room_orders/{tableId} {
        allow read: if isRestaurantMember(restaurantId);
        allow create: if isRestaurantMember(restaurantId)
          && isValidCanonicalRoomOrderWrite(restaurantId, tableId);
        allow update: if isRestaurantMember(restaurantId)
          && isValidCanonicalRoomOrderWrite(restaurantId, tableId)
          && keepsSameRoomOrderStableIdentity(tableId);
        allow delete: if isManagerOrAdmin(restaurantId);
      }

      match /room_order_bootstrap/{docId} {
        allow read: if docId == 'current'
          && isRestaurantMember(restaurantId);
        allow create, update: if docId == 'current'
          && isRestaurantMember(restaurantId);
        allow delete: if docId == 'current'
          && isManagerOrAdmin(restaurantId);

        match /tables/{tableId} {
          allow read: if docId == 'current'
            && isRestaurantMember(restaurantId);
          allow create, update: if docId == 'current'
            && isRestaurantMember(restaurantId)
            && request.resource.data.tableId == tableId;
          allow delete: if docId == 'current'
            && isRestaurantMember(restaurantId);
        }
      }

      match /room_order_ops/{opId} {
        allow read: if isRestaurantMember(restaurantId);
        allow create: if isRestaurantMember(restaurantId)
          && isValidRoomOrderOpWrite(restaurantId, opId);
        allow update: if isRestaurantMember(restaurantId)
          && isValidRoomOrderOpWrite(restaurantId, opId)
          && keepsSameRoomOrderOpIdentity(opId);
        allow delete: if isManagerOrAdmin(restaurantId);
      }

      match /operations/{operationId} {
        allow read: if isRestaurantMember(restaurantId);
        allow create: if isRestaurantMember(restaurantId)
          && isValidDistributedOperationWrite(restaurantId, operationId);
        allow update: if isRestaurantMember(restaurantId)
          && isValidDistributedOperationWrite(restaurantId, operationId)
          && keepsSameDistributedOperationIdentity(operationId);
        allow delete: if false;
      }

      match /devices/{deviceId} {
        allow read: if isRestaurantMember(restaurantId);
        allow create, update: if isRestaurantMember(restaurantId)
          && isValidDeviceSyncStateWrite(deviceId);
        allow delete: if false;
      }

      match /acks/{ackId} {
        allow read: if isRestaurantMember(restaurantId);
        allow create, update: if isRestaurantMember(restaurantId)
          && isValidOperationAckWrite();
        allow delete: if false;
      }

      match /snapshots/{snapshotId} {
        allow read: if isRestaurantMember(restaurantId);
        allow create, update: if isRestaurantMember(restaurantId);
        allow delete: if false;
      }

      match /sync_leases/{leaseId} {
        allow read: if isRestaurantMember(restaurantId);
        allow create, update: if isRestaurantMember(restaurantId)
          && request.resource.data.namespace is string;
        allow delete: if isManagerOrAdmin(restaurantId);
      }

      match /sync_counters/{counterId} {
        allow read: if isRestaurantMember(restaurantId);
        allow create: if isRestaurantMember(restaurantId)
          && isValidSyncCounterCreate(counterId);
        allow update: if isRestaurantMember(restaurantId)
          && isValidSyncCounterUpdate(counterId);
        allow delete: if isManagerOrAdmin(restaurantId);
      }

      match /device_presence_v1/{deviceId} {
        allow read: if isRestaurantMember(restaurantId);
        allow create, update: if isRestaurantMember(restaurantId)
          && request.resource.data.deviceId == deviceId;
        allow delete: if isManagerOrAdmin(restaurantId);
      }

      match /license/{licenseId} {
        allow read: if licenseId == 'current'
          && isRestaurantMember(restaurantId);
        allow create: if licenseId == 'current'
          && isRestaurantMember(restaurantId)
          && isDefaultFreeLicenseCreate(restaurantId);
        allow update: if licenseId == 'current'
          && isRestaurantMember(restaurantId)
          && isValidRestaurantLicenseWrite(restaurantId)
          && keepsSameCommercialLicenseTerms()
          && (
            licenseDeviceSlotsIncremented()
            || (isAdmin(restaurantId) && licenseDeviceSlotsDecremented())
          );
        allow delete: if false;
      }

      match /licensed_devices/{deviceId} {
        allow read: if isRestaurantMember(restaurantId);
        allow create: if isRestaurantMember(restaurantId)
          && isValidLicensedDeviceWrite(deviceId)
          && isOwnLicensedDeviceClaim()
          && request.resource.data.active == true
          && licenseAllowsNewDeviceClaim(restaurantId);
        allow update: if isRestaurantMember(restaurantId)
          && isValidLicensedDeviceWrite(deviceId)
          && request.resource.data.deviceId == resource.data.deviceId
          && keepsSameLicensedDeviceOwner()
          && (
            (
              isOwnLicensedDeviceClaim()
              && resource.data.active == true
              && request.resource.data.active == true
            )
            || (
              isOwnLicensedDeviceClaim()
              && resource.data.active == false
              && request.resource.data.active == true
              && licenseAllowsNewDeviceClaim(restaurantId)
            )
            || (
              isAdmin(restaurantId)
              && resource.data.active == true
              && request.resource.data.active == false
              && licenseAllowsDeviceRemoval(restaurantId)
            )
          );
        allow delete: if false;
      }

      match /user_device_sessions/{userId} {
        allow read: if isOwnUserDoc(userId) || isManagerOrAdmin(restaurantId);
        allow create: if isOwnUserDoc(userId)
          && isRestaurantMember(restaurantId)
          && isValidUserDeviceSessionWrite(restaurantId, userId);
        allow update: if (
            isOwnUserDoc(userId)
            && isRestaurantMember(restaurantId)
            && isValidUserDeviceSessionWrite(restaurantId, userId)
          )
          || (
            isAdmin(restaurantId)
            && isValidUserDeviceSessionWrite(restaurantId, userId)
          );
        allow delete: if isAdmin(restaurantId);
      }

      match /printer_relay_jobs_v1/{jobId} {
        allow read: if isRestaurantMember(restaurantId);
        allow create, update: if isRestaurantMember(restaurantId);
        allow delete: if isManagerOrAdmin(restaurantId);
      }

      match /print_jobs/{printJobId} {
        allow read: if isRestaurantMember(restaurantId);
        allow create: if isRestaurantMember(restaurantId)
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.printJobId == printJobId;
        allow update: if isRestaurantMember(restaurantId)
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.printJobId == printJobId
          && resource.data.restaurantId == restaurantId
          && resource.data.printJobId == printJobId
          && resource.data.status != 'printed';
        allow delete: if isManagerOrAdmin(restaurantId);
      }

      // ==========================================================================
      // [SITE] Sous-collections propres au site
      // ==========================================================================

      // Menu QR du site : lisible par le public quand la page est publiee.
      match /menus/{menuId} {
        allow read: if isRestaurantMember(restaurantId)
          || (
            exists(restaurantPath(restaurantId))
            && get(restaurantPath(restaurantId)).data.get('publicPageEnabled', false) == true
          );
        allow write: if isAdmin(restaurantId);
      }

      // Ancien nom de la collection clients, lu par le dashboard du site :
      // memes droits que « customers ». Le nom generique est neutralise par la
      // condition : aucune autre sous-collection n'est ouverte par ce bloc.
      match /{legacyCustomers}/{customerId} {
        allow read: if legacyCustomers == 'Customers' && isRestaurantMember(restaurantId);
        allow create, update: if legacyCustomers == 'Customers' && isRestaurantMember(restaurantId);
        allow delete: if legacyCustomers == 'Customers' && isManagerOrAdmin(restaurantId);

        match /movements/{movementId} {
          allow read: if legacyCustomers == 'Customers' && isRestaurantMember(restaurantId);
        }
      }

      // TRANSITION : ancienne collection des roles du site, en lecture seule, le
      // temps que l'ancien site soit remplace. A retirer ensuite (aucun droit
      // n'en decoule : les roles viennent de staff / staff_users).
      match /members/{uid} {
        allow read: if isRestaurantMember(restaurantId);
      }
    }

    // ==========================================================================
    // [APPLI] Mise a jour de l'application (version cible, telechargement)
    // ==========================================================================

    match /app_release/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ==========================================================================
    // [SITE] Site public : formulaire de contact et miroir public des restaurants
    // ==========================================================================

    // Formulaire de contact du site : ecriture seule, champs et tailles bornes.
    match /contactMessages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'company', 'message', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'email', 'message'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 3 && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('.+@.+')
        && request.resource.data.get('company', '') is string
        && request.resource.data.get('company', '').size() <= 160
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 4000
        && request.resource.data.get('status', 'new') == 'new'
        && request.resource.data.get('createdAt', request.time) == request.time;
      allow read, update, delete: if false;
    }

    // Miroir public d'un restaurant (pages restaurants/*.html) : lisible par tous
    // tant que la page est publiee, modifiable par les admins du restaurant.
    match /publicRestaurants/{publicId} {
      allow read: if resource.data.publicPageEnabled == true;
      allow create: if signedIn()
        && request.resource.data.restaurantId is string
        && isAdmin(request.resource.data.restaurantId);
      allow update: if signedIn()
        && resource.data.restaurantId == request.resource.data.restaurantId
        && isAdmin(request.resource.data.restaurantId);
      allow delete: if false;
    }
  }
}
