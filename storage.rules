rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function validImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /restaurants/{restaurantId}/branding/{fileName} {
      allow read: if true;
      allow write: if signedIn() && validImage();
    }
  }
}
