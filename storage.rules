rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function validImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Memes roles que firestore.rules (fiche staff ou createur du restaurant).
    // Storage ne peut consulter que 2 documents Firestore par requete : la fiche
    // restaurants/{id}/staff/{uid} et le document restaurant. L'ancienne
    // collection staff_users n'est donc pas prise en compte ici.
    function isRestaurantCreator(restaurantId) {
      return firestore.exists(/databases/(default)/documents/restaurants/$(restaurantId))
        && (
          firestore.get(/databases/(default)/documents/restaurants/$(restaurantId)).data.get('createdBy', '') == request.auth.uid
          || firestore.get(/databases/(default)/documents/restaurants/$(restaurantId)).data.get('ownerUid', '') == request.auth.uid
        );
    }

    function hasStaffRole(restaurantId, roles) {
      return signedIn()
        && (
          (
            firestore.exists(/databases/(default)/documents/restaurants/$(restaurantId)/staff/$(request.auth.uid))
            && firestore.get(/databases/(default)/documents/restaurants/$(restaurantId)/staff/$(request.auth.uid)).data.get('active', true) != false
            && firestore.get(/databases/(default)/documents/restaurants/$(restaurantId)/staff/$(request.auth.uid)).data.role in roles
          )
          || isRestaurantCreator(restaurantId)
        );
    }

    // A la creation d'un restaurant, le logo est envoye avant que le document
    // Firestore n'existe : ecriture autorisee tant que l'identifiant est libre.
    function restaurantNotCreatedYet(restaurantId) {
      return signedIn()
        && !firestore.exists(/databases/(default)/documents/restaurants/$(restaurantId));
    }

    // Logo et couverture = profil du restaurant : administrateurs.
    match /restaurants/{restaurantId}/branding/{fileName} {
      allow read: if true;
      allow write: if (restaurantNotCreatedYet(restaurantId) || hasStaffRole(restaurantId, ['admin', 'owner']))
        && validImage();
    }

    // Photos du catalogue : manager et administrateurs, comme catalog_categories.
    match /restaurants/{restaurantId}/catalog/{categoryId}/{fileName} {
      allow read: if true;
      allow write: if (restaurantNotCreatedYet(restaurantId) || hasStaffRole(restaurantId, ['admin', 'owner', 'manager']))
        && validImage();
    }
  }
}
